<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_black"
                android:text="@string/app_name"
                android:textSize="23sp"
                android:textColor="@color/text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/offlineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingEnd="11dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_dot_ok" />

                <TextView
                    android:id="@+id/offlineText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/offline_badge"
                    android:textSize="11sp"
                    android:textColor="@color/text_dim" />
            </LinearLayout>
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/stroke" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textSize="12sp"
            android:textColor="@color/text_faint" />

        <LinearLayout
            android:id="@+id/langBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_hero"
            android:padding="6dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipFa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_chip_on"
                android:text="@string/lang_fa"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent_text"
                android:clickable="true"
                android:focusable="true" />

            <studio.am.hamzaban.ui.widget.IconView
                android:id="@+id/btnSwap"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_round_ripple"
                android:textSize="20sp"
                android:textColor="@color/accent"
                android:contentDescription="@string/cd_swap"
                android:clickable="true"
                android:focusable="true"
                app:glyph="swap_horiz" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipEn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_row_ripple"
                android:text="@string/lang_en"
                android:textSize="15sp"
                android:textColor="@color/text_dim"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/srcInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="112dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/hint_input"
                android:textColorHint="@color/text_faint"
                android:textSize="19sp"
                android:textColor="@color/text"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2000"
                android:importantForAutofill="no"
                android:padding="0dp"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/charCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_faint" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <studio.am.hamzaban.ui.widget.IconView
                    android:id="@+id/btnClear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_ripple"
                    android:textSize="18sp"
                    android:textColor="@color/text_dim"
                    android:contentDescription="@string/cd_clear"
                    android:clickable="true"
                    android:focusable="true"
                    app:glyph="close" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="@string/action_translate"
            android:textColor="@color/on_btn"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/errorBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_hero"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/danger"
                android:lineSpacingExtra="3dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="44dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="@string/action_retry"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_hero"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/modeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_accent_pill"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_text"
                    android:maxLines="1" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <studio.am.hamzaban.ui.widget.IconView
                    android:id="@+id/btnSpeak"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_ripple"
                    android:textSize="19sp"
                    android:textColor="@color/text_dim"
                    android:contentDescription="@string/cd_speak"
                    android:clickable="true"
                    android:focusable="true"
                    app:glyph="volume_up" />

                <studio.am.hamzaban.ui.widget.IconView
                    android:id="@+id/btnCopy"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_ripple"
                    android:textSize="19sp"
                    android:textColor="@color/text_dim"
                    android:contentDescription="@string/cd_copy"
                    android:clickable="true"
                    android:focusable="true"
                    app:glyph="content_copy" />

                <studio.am.hamzaban.ui.widget.IconView
                    android:id="@+id/btnShare"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_ripple"
                    android:textSize="19sp"
                    android:textColor="@color/text_dim"
                    android:contentDescription="@string/cd_share"
                    android:clickable="true"
                    android:focusable="true"
                    app:glyph="share" />

                <studio.am.hamzaban.ui.widget.IconView
                    android:id="@+id/btnSave"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_ripple"
                    android:textSize="19sp"
                    android:textColor="@color/text_dim"
                    android:contentDescription="@string/cd_save"
                    android:clickable="true"
                    android:focusable="true"
                    app:glyph="bookmark" />
            </LinearLayout>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="20sp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <studio.am.hamzaban.ui.widget.IconView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textColor="@color/accent"
                app:glyph="auto_awesome" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_result_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_result_sub"
                android:textSize="13sp"
                android:textColor="@color/text_dim"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
