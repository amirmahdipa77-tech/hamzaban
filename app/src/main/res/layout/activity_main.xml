<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:text="@string/app_name"
            android:textSize="15sp"
            android:textColor="@color/text" />

        <View
            android:id="@+id/liveDot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_live" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <studio.am.hamzaban.ui.widget.IconView
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:background="@drawable/bg_round_ripple"
            android:tint="@color/text_dim"
            android:contentDescription="@string/cd_settings"
            android:clickable="true"
            android:focusable="true"
            app:glyph="settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/langRail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/langFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn_black"
                android:textSize="26sp"
                android:textColor="@color/text"
                android:maxLines="1"
                android:ellipsize="end" />

            <studio.am.hamzaban.ui.widget.IconView
                android:id="@+id/btnSwap"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/bg_round_ripple"
                android:tint="@color/accent"
                android:contentDescription="@string/cd_swap"
                android:clickable="true"
                android:focusable="true"
                app:glyph="swap_horiz" />

            <TextView
                android:id="@+id/langTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:fontFamily="@font/vazirmatn_black"
                android:textSize="26sp"
                android:textColor="@color/text_dim"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_gradient_line" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/srcInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:maxHeight="200dp"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/hint_input"
        android:textColorHint="@color/text_faint"
        android:textSize="15sp"
        android:textColor="@color/text"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="3000"
        android:importantForAutofill="no"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:lineSpacingExtra="3dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/resultScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/modeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_accent_pill"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:maxLines="1" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/btnSpeak"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="7dp"
                        android:background="@drawable/bg_round_ripple"
                        android:tint="@color/text_dim"
                        android:contentDescription="@string/cd_speak"
                        android:clickable="true"
                        android:focusable="true"
                        app:glyph="volume_up" />

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/btnCopy"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="7dp"
                        android:background="@drawable/bg_round_ripple"
                        android:tint="@color/text_dim"
                        android:contentDescription="@string/cd_copy"
                        android:clickable="true"
                        android:focusable="true"
                        app:glyph="content_copy" />

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/btnShare"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="7dp"
                        android:background="@drawable/bg_round_ripple"
                        android:tint="@color/text_dim"
                        android:contentDescription="@string/cd_share"
                        android:clickable="true"
                        android:focusable="true"
                        app:glyph="share" />
                </LinearLayout>

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="18sp"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_black"
                android:text="@string/empty_hero"
                android:textSize="22sp"
                android:textColor="@color/text"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/empty_result_sub"
                android:textSize="13sp"
                android:textColor="@color/text_faint"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chip1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/suggest_1"
                    android:textSize="12sp"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/suggest_2"
                    android:textSize="12sp"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/chip3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/suggest_3"
                    android:textSize="12sp"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
