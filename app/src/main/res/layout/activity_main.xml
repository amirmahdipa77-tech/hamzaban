<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke" />

    <FrameLayout
        android:id="@+id/navBarWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg">

        <FrameLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/navIndicator"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_gravity="top|left"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_nav_indicator" />

            <LinearLayout
                android:id="@+id/navItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/navItemTranslate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/navIconTranslate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textColor="@color/text_dim"
                        app:glyph="translate" />

                    <TextView
                        android:id="@+id/navLabelTranslate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_translate"
                        android:textSize="10sp"
                        android:textColor="@color/text_dim"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navItemHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/navIconHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textColor="@color/text_dim"
                        app:glyph="history" />

                    <TextView
                        android:id="@+id/navLabelHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_history"
                        android:textSize="10sp"
                        android:textColor="@color/text_dim"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navItemSaved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/navIconSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textColor="@color/text_dim"
                        app:glyph="bookmark" />

                    <TextView
                        android:id="@+id/navLabelSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_saved"
                        android:textSize="10sp"
                        android:textColor="@color/text_dim"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navItemSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <studio.am.hamzaban.ui.widget.IconView
                        android:id="@+id/navIconSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textColor="@color/text_dim"
                        app:glyph="settings" />

                    <TextView
                        android:id="@+id/navLabelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tab_settings"
                        android:textSize="10sp"
                        android:textColor="@color/text_dim"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
