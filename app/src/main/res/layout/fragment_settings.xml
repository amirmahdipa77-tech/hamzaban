<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:text="@string/settings_title"
            android:textSize="26sp"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/set_appearance"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_faint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_theme"
                android:textSize="13sp"
                android:textColor="@color/text_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_seg_group"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segThemeSystem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_on"
                    android:text="@string/theme_system"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_btn"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_off"
                    android:text="@string/theme_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_off"
                    android:text="@string/theme_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/stroke" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_language"
                android:textSize="13sp"
                android:textColor="@color/text_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_seg_group"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segLangFa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_on"
                    android:text="فارسی"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_btn"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segLangEn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_off"
                    android:text="English"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/stroke" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_font"
                android:textSize="13sp"
                android:textColor="@color/text_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_seg_group"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segFontSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_off"
                    android:text="@string/font_small"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segFontNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_on"
                    android:text="@string/font_normal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_btn"
                    android:clickable="true"
                    android:focusable="true" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/segFontLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/bg_seg_off"
                    android:text="@string/font_large"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dim"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/set_models"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_faint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/models_desc"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:id="@+id/modelsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="8dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnAddLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="@string/models_add"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/set_about"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_faint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_black"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/about_desc"
                android:textSize="13sp"
                android:textColor="@color/text_dim"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:textColor="@color/text_faint" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:background="@color/stroke" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_made"
                android:textSize="13sp"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/aboutGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="32dp"
                android:text="@string/about_source"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_text"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_license"
                android:textSize="13sp"
                android:textColor="@color/text_dim" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="AM Studio"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textColor="@color/text_faint" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
