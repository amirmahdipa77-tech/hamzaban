<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <studio.am.hamzaban.ui.widget.IconView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/accent"
                android:importantForAccessibility="no"
                app:glyph="swap_horiz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/vazirmatn_black"
                android:text="@string/app_name"
                android:textSize="16sp"
                android:textColor="@color/text" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_black"
            android:text="@string/onb_title"
            android:textSize="30sp"
            android:textColor="@color/text"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onb_sub"
            android:textSize="15sp"
            android:textColor="@color/text_dim"
            android:lineSpacingExtra="6dp" />

        <LinearLayout
            android:id="@+id/mark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hero"
                android:padding="14dp">

                <TextView
                    android:id="@+id/statA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_black"
                    android:textSize="19sp"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stat_entries"
                    android:textSize="11sp"
                    android:textColor="@color/text_faint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hero"
                android:padding="14dp">

                <TextView
                    android:id="@+id/statB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_black"
                    android:textSize="19sp"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stat_download"
                    android:textSize="11sp"
                    android:textColor="@color/text_faint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hero"
                android:padding="14dp">

                <TextView
                    android:id="@+id/statC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn_black"
                    android:textSize="19sp"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stat_offline"
                    android:textSize="11sp"
                    android:textColor="@color/text_faint" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feature1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <studio.am.hamzaban.ui.widget.IconView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:textSize="18sp"
                android:textColor="@color/accent"
                android:importantForAccessibility="no"
                app:glyph="offline_bolt" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/onb_f1"
                android:textSize="13sp"
                android:textColor="@color/text_dim"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feature2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <studio.am.hamzaban.ui.widget.IconView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:textSize="18sp"
                android:textColor="@color/accent"
                android:importantForAccessibility="no"
                app:glyph="check_circle" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/onb_f2"
                android:textSize="13sp"
                android:textColor="@color/text_dim"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feature3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <studio.am.hamzaban.ui.widget.IconView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:textSize="18sp"
                android:textColor="@color/accent"
                android:importantForAccessibility="no"
                app:glyph="auto_awesome" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/onb_f3"
                android:textSize="13sp"
                android:textColor="@color/text_dim"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:minHeight="56dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="@string/onb_start"
            android:textColor="@color/on_btn"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/onb_note"
            android:textSize="11sp"
            android:textColor="@color/text_faint" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
